  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "codemirror": "^5.65.18"
  },
  "devDependencies": {
    "@types/codemirror": "^5.60.16",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2"
  }
